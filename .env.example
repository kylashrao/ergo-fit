# Set the canonical HTTPS origin before building for production.
NEXT_PUBLIC_SITE_URL=https://ergo-fit.example

# Public identity displayed on the trust pages. Replace these before launch.
SITE_OPERATOR=
SITE_CONTACT_EMAIL=

# Optional. Copy your real ca-pub-... client ID from AdSense.
# The ID adds Google's verification meta tag without loading an ad script.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Default false. true plus a valid client ID previews the reserved manual slot.
# This readiness build never requests ads. Connect a consent-gated ad unit
# after AdSense approval and publish the real seller entry in public/ads.txt.
NEXT_PUBLIC_ADSENSE_ENABLED=false
